[Unit]
Description=Pennywise finance tracker
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/pennywise/backend
ExecStart=%h/Documents/pennywise/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
